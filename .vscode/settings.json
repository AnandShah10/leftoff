{
    "workbench.colorCustomizations": {
        "editor.background": "#201e20",
        "editor.foreground": "#D6DAE0",
        "editorLineNumber.foreground": "#6A737D",
        "editorLineNumber.activeForeground": "#5FB0FF",
        "editorCursor.foreground": "#8a9fca",
        "editor.selectionBackground": "#5FB0FF33",
        "editor.lineHighlightBackground": "#5FB0FF14",
        "activityBar.background": "#1c181a",
        "activityBar.foreground": "#D6DAE0",
        "activityBar.activeBorder": "#5fbbac",
        "activityBarBadge.background": "#88aea9",
        "activityBarBadge.foreground": "#0b0d10",
        "sideBar.background": "#1c181a",
        "sideBar.foreground": "#D6DAE0",
        "sideBarTitle.foreground": "#D6DAE0",
        "sideBarSectionHeader.background": "#1B1E23",
        "statusBar.background": "#676064",
        "statusBar.foreground": "#D6DAE0",
        "statusBar.debuggingBackground": "#d1a62f",
        "titleBar.activeBackground": "#1c181a",
        "titleBar.activeForeground": "#D6DAE0",
        "tab.activeBackground": "#1B1E23",
        "tab.inactiveBackground": "#15171B",
        "tab.activeBorderTop": "#60b6bd",
        "terminal.background": "#1B1E23",
        "terminal.foreground": "#D6DAE0",
        "terminal.ansiGreen": "#3FB950",
        "terminal.ansiYellow": "#D4A72C",
        "terminal.ansiRed": "#F85149",
        "terminal.ansiBlue": "#B792F5",
        "button.background": "#63b3e5",
        "button.foreground": "#0b0d10",
        "focusBorder": "#5FB0FF",
        "gitDecoration.modifiedResourceForeground": "#b5ab34",
        "gitDecoration.addedResourceForeground": "#3FB950",
        "gitDecoration.deletedResourceForeground": "#f3544d",
        "badge.background": "#5FB0FF",
        "progressBar.background": "#6cb0ef",
        "editorError.foreground": "#de625d",
        "editorWarning.foreground": "#c5a23f",
        "breadcrumb.activeSelectionForeground": "#61a7d7"
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": [
                    "comment"
                ],
                "settings": {
                    "foreground": "#6A737D",
                    "fontStyle": "italic"
                }
            },
            {
                "scope": [
                    "string"
                ],
                "settings": {
                    "foreground": "#8FCB7E"
                }
            },
            {
                "scope": [
                    "keyword",
                    "storage.type",
                    "storage.modifier"
                ],
                "settings": {
                    "foreground": "#FF7EB6"
                }
            },
            {
                "scope": [
                    "entity.name.function"
                ],
                "settings": {
                    "foreground": "#8FA6B5"
                }
            },
            {
                "scope": [
                    "entity.name.class",
                    "entity.name.type"
                ],
                "settings": {
                    "foreground": "#60d454"
                }
            },
            {
                "scope": [
                    "variable"
                ],
                "settings": {
                    "foreground": "#D6DAE0"
                }
            },
            {
                "scope": [
                    "constant.numeric"
                ],
                "settings": {
                    "foreground": "#D4A72C"
                }
            },
            {
                "scope": [
                    "invalid"
                ],
                "settings": {
                    "foreground": "#de625d"
                }
            }
        ]
    }
}